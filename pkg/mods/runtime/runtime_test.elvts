# runtime module with good paths #

//use-runtime-good-paths

~> put $runtime:lib-dirs
▶ [/lib/1 /lib/2]
~> put $runtime:rc-path
▶ /path/to/rc.elv
~> put $runtime:effective-rc-path
▶ /path/to/effective/rc.elv
~> put $runtime:elvish-path
▶ /path/to/elvish

# runtime module with bad paths #

//use-runtime-bad-paths

~> put $runtime:lib-dirs
▶ []
~> put $runtime:elvish-path
▶ $nil
~> put $runtime:rc-path
▶ $nil
~> put $runtime:effective-rc-path
▶ $nil

# runtime:context returns live shell state #

~> use runtime
~> var c = (runtime:context)
~> put $c[shell]
▶ elvish
~> keys $c | order
▶ aliases
▶ builtins
▶ functions
▶ jobs
▶ shell
▶ variables
~> put $c[jobs]
▶ []
~> put $c[aliases]
▶ []

# context reflects functions defined after module load #

~> use runtime
~> fn my-func { }
~> put (runtime:context)[functions]
▶ [my-func]
~> fn other-func { }
~> put (runtime:context)[functions]
▶ [my-func other-func]

# context reflects variables defined after module load #

~> use runtime
~> var my-var = x
~> use str
~> str:contains (str:join ',' (runtime:context)[variables]) ',my-var'
▶ $true

# context includes builtin special forms and builtin functions #

~> use runtime
~> use str
~> var b = (str:join ',' (runtime:context)[builtins])
~> str:contains $b ',if,'
▶ $true
~> str:contains $b ',put,'
▶ $true
